{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["agesignals"],
  "ios": {
    "iosModuleName": "ReactNativeAgeSignals"
  },
  "android": {
    "androidNamespace": ["agesignals"],
    "androidCxxLibName": "ReactNativeAgeSignals"
  },
  "autolinking": {
    "AgeSignals": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridAgeSignals"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridAgeSignals"
      }
    }
  },
  "ignorePaths": ["**/node_modules", "**/build", "**/example"]
}
