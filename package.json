{
  "name": "react-native-age-signals",
  "version": "0.3.1",
  "description": "Apple Declared Age Range and Google Play Age Signals for React Native / Expo",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./testing": {
      "types": "./build/testing.d.ts",
      "default": "./build/testing.js"
    }
  },
  "files": [
    "build",
    "ios",
    "android",
    "nitrogen/generated",
    "ReactNativeAgeSignals.podspec",
    "react-native.config.js"
  ],
  "scripts": {
    "codegen": "npx nitrogen",
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "age-signals",
    "age-verification",
    "declared-age",
    "storekit",
    "play-age-signals",
    "texas-law",
    "brazil-law",
    "child-safety"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shtefanilie/react-native-age-signals.git"
  },
  "bugs": {
    "url": "https://github.com/shtefanilie/react-native-age-signals/issues"
  },
  "author": "Stefan Ilie <stefanionut92@gmail.com> (https://stefanilie.com)",
  "license": "MIT",
  "homepage": "https://github.com/shtefanilie/react-native-age-signals#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.1.1",
    "babel-preset-expo": "~55.0.8",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo-modules-core": "~57.0.10",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.9",
    "nitrogen": "^0.36.1",
    "prettier": "^3.0.0",
    "react-native": "0.82.1",
    "react-native-nitro-modules": "^0.36.1",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*)"
    ],
    "moduleNameMapper": {
      "^react-native-nitro-modules$": "<rootDir>/src/__mocks__/react-native-nitro-modules.ts",
      "^expo/src/winter(.*)$": "<rootDir>/src/__mocks__/expo-winter.ts"
    }
  },
  "platforms": {
    "ios": true,
    "android": true,
    "web": false,
    "expoGo": false
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  }
}
